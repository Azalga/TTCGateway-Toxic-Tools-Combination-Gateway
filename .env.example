# ==============================================================================
# TTCGateway Environment Configuration Template
# Copy this file to .env and configure your local or cloud endpoints
# ==============================================================================

# 1. Target LLM Model Configuration
# Can also be set in model.txt (first line) or via CLI flags (--model)
MODEL_NAME=qwen3.5:9b

# 2. Cloud Provider API Keys (leave empty if using local Ollama)
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 3. Upstream Endpoints
UPSTREAM_LLM_URL=http://localhost:11434/v1/chat/completions
OLLAMA_URL=http://localhost:11434/v1/chat/completions
GOOGLE_LLM_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
OPENROUTER_LLM_URL=https://openrouter.ai/api/v1/chat/completions

# 4. SRE Control Plane & Administrative Security
# Key required to interact with /v1/admin/tags for dynamic quarantine
ADMIN_API_KEY=
